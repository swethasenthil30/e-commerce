# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Port
PORT=3000

# MongoDB Connection String (e.g. MongoDB Atlas or local MongoDB)
# Note: If no external MongoDB instance is running, NovaMart automatically falls back to its persistent JSON/in-memory database engine with seed data.
MONGODB_URI="mongodb://127.0.0.1:27017/novamart"

# JSON Web Token Secret Key for signing user and admin session tokens
JWT_SECRET="novamart_jwt_super_secure_secret_token_key_2026"

# Node Environment
NODE_ENV="development"
